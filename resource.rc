// NovaFile app icon + version resource.
// Icon: the wave logo from Icon.png, converted by build/icon_from_png.ps1
// (see BUILDING.txt, APP ICON).  Embedded by windres in compile.bat /
// Makefile; icon resource id 1 is loaded as the window class icon in
// src/platform/window_win.c.  The VERSIONINFO block below is the single
// file/version source used by Explorer, the installer and update checks.
#include "include/version.h"
1 ICON "NovaFile.ico"
1 VERSIONINFO
 FILEVERSION NOVA_VERSION_MAJOR,NOVA_VERSION_MINOR,NOVA_VERSION_PATCH,0
 PRODUCTVERSION NOVA_VERSION_MAJOR,NOVA_VERSION_MINOR,NOVA_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", NOVA_PUBLISHER "\0"
            VALUE "FileDescription", NOVA_PRODUCT "\0"
            VALUE "FileVersion", NOVA_VERSION "\0"
            VALUE "InternalName", "NovaFile\0"
            VALUE "LegalCopyright", "Copyright (c) " NOVA_PUBLISHER "\0"
            VALUE "OriginalFilename", "NovaFile.exe\0"
            VALUE "ProductName", NOVA_PRODUCT "\0"
            VALUE "ProductVersion", NOVA_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
